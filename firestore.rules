  match /notificationTokens/{uid}/tokens/{tokenId} {
    allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
  }

  match /adminProfiles/{uid}{allow read:if self(uid)||admin();allow create:if strongAdmin()||(signedIn()&&uid==request.auth.uid&&request.resource.data.uid==request.auth.uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.role=="Administrator"&&request.resource.data.active==true&&request.resource.data.invitationId is string&&exists(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId))&&get(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId)).data.email==request.auth.token.email&&get(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId)).data.status=="Pending");allow update:if (strongAdmin()&&uid!=request.auth.uid)||(signedIn()&&uid==request.auth.uid&&resource.data.active==false&&request.resource.data.active==true&&request.resource.data.email==request.auth.token.email&&request.resource.data.role=="Administrator"&&request.resource.data.invitationId is string&&exists(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId))&&get(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId)).data.email==request.auth.token.email&&get(/databases/$(database)/documents/adminInvitations/$(request.resource.data.invitationId)).data.status=="Pending");allow delete:if false;}
  match /adminInvitations/{id}{allow read:if admin()||(signedIn()&&resource.data.email==request.auth.token.email);allow create:if strongAdmin()&&request.resource.data.email is string&&request.resource.data.name is string&&request.resource.data.role=="Administrator"&&request.resource.data.status=="Pending"&&request.resource.data.createdByUid==request.auth.uid;allow update:if strongAdmin()||(signedIn()&&resource.data.email==request.auth.token.email&&resource.data.status=="Pending"&&request.resource.data.status=="Activated"&&request.resource.data.activatedUid==request.auth.uid&&request.resource.data.email==resource.data.email);allow delete:if strongAdmin();}
  function registrationReviewer(){return admin()||anyMemberRole(["Executive Director","Director Human Resources","HR Manager","Director Finance & Administration","Finance Manager","Director Livestock","Livestock Director","Director Environment","Director Outreach","Director Community Development","Director Field","Director Operations","Operations Director","Director Internal Oversight","Internal Oversight Director"]);}