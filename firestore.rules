rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function self(uid){return signedIn()&&request.auth.uid==uid;}
  function adminProfileExists(){return signedIn()&&exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid));}
  function admin(){return adminProfileExists()&&get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.active==true;}
  function memberProfileExists(){return signedIn()&&exists(/databases/$(database)/documents/members/$(request.auth.uid));}
  function activeMember(){return memberProfileExists()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status=="Active";}
  function role(r){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role==r;}
  function anyMemberRole(roles){return activeMember()&&roles.hasAny([get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role]);}
  function governanceUser(){return admin()||activeMember();}
  function financeDepartmentMember(){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department=="Finance & Administration"&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unit in ["Finance Unit","Accounting Unit"];}function procurementDepartmentMember(){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department=="Finance & Administration"&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unit=="Procurement Unit";}function financePersonnel(){return admin()||financeDepartmentMember()||anyMemberRole(["Finance Personnel","Finance Manager","Accountant","Finance Officer","Executive Director","Director Finance & Administration"]);}
  function financeOversight(){return admin()||anyMemberRole(["Executive Director","Director Internal Oversight","Internal Oversight Officer"]);}
  function financeApprovalOfficer(){return admin()||anyMemberRole(["Executive Director","Director Finance & Administration","Finance Manager","Accountant","Finance Officer"]);}function financePortfolioViewer(){return financePersonnel()||financeApprovalOfficer();}
  function procurementTeam(){return admin()||procurementDepartmentMember()||anyMemberRole(["Procurement Officer","Procurement Manager","Procurement Team Member"]);}
  function procurementApprover(){return admin()||anyMemberRole(["Executive Director","Director Livestock","Livestock Director","Director Internal Oversight","Internal Oversight Director","Director Finance & Administration","Director Human Resources","Director Outreach","Director Community Development","Director Environment","Director Field","Director Operations","Operations Director","Outreach Director","Community Development Director","Environment Director","Field Director"]);}
  function validProcurementDepartment(d){return d in ["Executive Office","Internal Oversight","Livestock Development","Environment & Sustainable Rangeland Management","Finance & Administration","Human Resources","Outreach","Community Development","Field Department","Operations"];}
  function validProcurementUnit(d,u){return (d=="Executive Office"&&u in ["Executive Director's Office","Management Coordination Unit"])||(d=="Internal Oversight"&&u in ["Internal Oversight Unit","Compliance & Assurance Unit"])||(d=="Livestock Development"&&u in ["Livestock Production Unit","Veterinary Services Unit","Breeding & Genetics Unit","Livestock Infrastructure Unit"])||(d=="Environment & Sustainable Rangeland Management"&&u in ["Rangeland Management Unit","Rangeland Restoration Unit","Invasive Species Control Unit","Climate Change & Resilience Unit","Environmental Conservation & Education Unit"])||(d=="Finance & Administration"&&u in ["Finance Unit","Accounting Unit","Administration Unit","Procurement Unit"])||(d=="Human Resources"&&u in ["Human Resources & Staff Welfare Unit","Training & Capacity Development Unit","Personnel & Records Unit"])||(d=="Outreach"&&u in ["Communications & Outreach Unit","Partnerships & Resource Mobilization Unit","ICT & Digital Engagement Unit"])||(d=="Community Development"&&u in ["Community Mobilization Unit","Women & Youth Empowerment Unit","Gender & Social Inclusion Unit"])||(d=="Field Department"&&u in ["Field Implementation Unit","Monitoring, Evaluation, Accountability & Learning Unit","Community-Based Monitoring Unit"])||(d=="Operations"&&u in ["Logistics & Transport Unit","Infrastructure & Facilities Unit","General Operations Unit"]);}
  function procurementLocationImmutable(){return request.resource.data.department==resource.data.department&&request.resource.data.unit==resource.data.unit;}
  function management(){return admin()||anyMemberRole(["Executive Director","Management","Finance Manager","Director Internal Oversight"]);}
  function hrManagement(){return admin()||anyMemberRole(["Executive Director","Director Human Resources","HR Manager"]);}
  function workflowParticipant(d){return governanceUser()&&d.involvedUids is list&&d.involvedUids.hasAny([request.auth.uid]);}
  function validWorkflowStatus(s){return s in ["Draft","Submitted","Under Review","Approved","Rejected","Returned","Completed","Evaluation","Ordered","Cancelled","Authorized","Superseded","Archived","Pending Signature","Signed","Declined","Expired","In Implementation","Implemented"];}
  function validWorkflowRecord(d){return d.workflowType is string&&d.module is string&&d.status is string&&validWorkflowStatus(d.status)&&d.stageIndex is int&&d.stageIndex>=0&&d.involvedUids is list;}
  function workflowUpdateAllowed(){return admin()||workflowParticipant(resource)||workflowParticipant(request.resource);}
  function workflowTerminal(){return resource.data.status in ["Completed","Rejected","Cancelled","Archived","Superseded","Signed","Declined","Expired","Implemented"];}
  function signatureDocumentWorkflowUpdate(){return activeMember()&&resource.data.signatureEnvelopeId is string&&getAfter(/databases/$(database)/documents/signatureEnvelopes/$(resource.data.signatureEnvelopeId)).data.participantUids is list&&getAfter(/databases/$(database)/documents/signatureEnvelopes/$(resource.data.signatureEnvelopeId)).data.participantUids.hasAny([request.auth.uid])&&request.resource.data.signatureEnvelopeId==resource.data.signatureEnvelopeId&&request.resource.data.signatureOwnerUid==resource.data.signatureOwnerUid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signatureEnvelopeId","signatureReference","signatureStatus","signatureOwnerUid","workflowOwnerSectionSaved","workflowActionStatus","lastWorkflowAction","lastWorkflowActionUid","lastWorkflowActionAt","authorizationStatus","completedDocumentUrl","ownerCompletedDocumentUrl","ownerCompletedDocumentPath","ownerRecordStatus","lastCompletedDocumentHash","documentArchiveUid","documentArchiveFolderId","documentArchiveUidLink","documentArchivePath","documentArchiveAccess","documentClassification","updatedAt"])&&(request.auth.uid==resource.data.signatureOwnerUid||request.resource.data.lastWorkflowActionUid==request.auth.uid);}
  function authorizationReviewerRole(uid){return exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.role in ["Director Internal Oversight","Internal Oversight Officer","Director Human Resources","HR Manager","Director Finance & Administration","Finance Manager","Programme/Technical Officer","Operations Manager"];}
  function authorizationApproverRole(uid){return exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.role=="Executive Director";}
  function authorizationImplementerRole(uid){return exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.role in ["Executive Director","Director Finance & Administration","Finance Manager","Operations Manager","Programme/Technical Officer","Director Human Resources","HR Manager"];}
  function validAuthorizationCreate(){return request.resource.data.workflowType=="Authorization"&&request.resource.data.module=="Authorization & Approvals"&&request.resource.data.status=="Draft"&&request.resource.data.stageIndex==0&&request.resource.data.requestedByUid==request.auth.uid&&request.resource.data.requestedByUid!=request.resource.data.approverUid&&request.resource.data.reviewerUid is string&&request.resource.data.approverUid is string&&authorizationReviewerRole(request.resource.data.reviewerUid)&&authorizationApproverRole(request.resource.data.approverUid)&&request.resource.data.involvedUids is list&&request.resource.data.involvedUids.hasAll([request.auth.uid,request.resource.data.reviewerUid,request.resource.data.approverUid])&&(!request.resource.data.keys().hasAny(["implementerUid"])||request.resource.data.implementerUid==null||authorizationImplementerRole(request.resource.data.implementerUid));}
  function authorizationImmutable(){return request.resource.data.workflowType==resource.data.workflowType&&request.resource.data.module==resource.data.module&&request.resource.data.reference==resource.data.reference&&request.resource.data.title==resource.data.title&&request.resource.data.requestedByUid==resource.data.requestedByUid&&request.resource.data.requestedByEmail==resource.data.requestedByEmail&&request.resource.data.reviewerUid==resource.data.reviewerUid&&request.resource.data.approverUid==resource.data.approverUid&&request.resource.data.implementerUid==resource.data.implementerUid&&request.resource.data.involvedUids==resource.data.involvedUids;}
  function authorizationTransitionAllowed(){return authorizationImmutable()&&((resource.data.status=="Draft"&&request.resource.data.status=="Submitted"&&request.resource.data.stageIndex==1&&resource.data.requestedByUid==request.auth.uid)||(resource.data.status=="Submitted"&&request.resource.data.status=="Under Review"&&request.resource.data.stageIndex==2&&resource.data.reviewerUid==request.auth.uid&&authorizationReviewerRole(request.auth.uid))||(resource.data.status in ["Submitted","Under Review"]&&request.resource.data.status=="Returned"&&request.resource.data.stageIndex==5&&resource.data.reviewerUid==request.auth.uid&&authorizationReviewerRole(request.auth.uid)&&request.resource.data.decisionReason is string&&request.resource.data.decisionReason.size()>0)||(resource.data.status=="Under Review"&&request.resource.data.status=="Approved"&&request.resource.data.stageIndex==3&&resource.data.approverUid==request.auth.uid&&authorizationApproverRole(request.auth.uid)&&resource.data.requestedByUid!=request.auth.uid)||(resource.data.status=="Under Review"&&request.resource.data.status=="Rejected"&&request.resource.data.stageIndex==4&&resource.data.approverUid==request.auth.uid&&authorizationApproverRole(request.auth.uid)&&resource.data.requestedByUid!=request.auth.uid&&request.resource.data.decisionReason is string&&request.resource.data.decisionReason.size()>0)||(resource.data.status=="Returned"&&request.resource.data.status=="Submitted"&&request.resource.data.stageIndex==1&&resource.data.requestedByUid==request.auth.uid)||(resource.data.status=="Approved"&&request.resource.data.status=="Completed"&&request.resource.data.stageIndex==6&&resource.data.implementerUid==request.auth.uid&&authorizationImplementerRole(request.auth.uid)));}
  match /adminProfiles/{uid}{allow read:if self(uid)||admin();allow create:if admin();allow update:if admin()&&uid!=request.auth.uid;allow delete:if false;}
  match /members/{id}{allow read:if admin()||self(id);allow create:if admin()||(self(id)&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=="Active"&&request.resource.data.invitationId is string&&exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))&&get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email==request.auth.token.email&&get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status!="Cancelled"&&request.resource.data.role==get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role&&request.resource.data.memberType==get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.memberType);allow update:if admin()||(self(id)&&request.resource.data.uid==request.auth.uid&&request.resource.data.role==resource.data.role&&request.resource.data.status==resource.data.status&&request.resource.data.invitationId==resource.data.invitationId);allow delete:if admin();}
  match /employees/{id}{allow read:if admin()||hrManagement()||procurementTeam()||procurementApprover()||anyMemberRole(["Director Finance & Administration","Finance Manager","Director Internal Oversight"])||(signedIn()&&resource.data.uid==request.auth.uid);allow create:if admin()||hrManagement()||(signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.invitationId is string&&exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))&&get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email==request.auth.token.email&&get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status!="Cancelled");allow update:if admin()||hrManagement()||(signedIn()&&resource.data.email==request.auth.token.email&&request.resource.data.uid==request.auth.uid&&request.resource.data.invitationId==resource.data.invitationId&&request.resource.data.accountActivated==true&&request.resource.data.registrationStatus=="Activated"&&request.resource.data.registrationEmailStatus=="Completed"&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid","invitationId","accountActivated","registrationStatus","registrationEmailStatus","activatedAt"]));allow delete:if admin();}
  match /employeeCounters/{id}{allow read:if admin()||hrManagement();allow create,update:if admin()||hrManagement();allow delete:if false;}
  match /memberCounters/{id}{allow read:if admin()||hrManagement();allow create,update:if admin()||hrManagement();allow delete:if false;}
  match /procurementVendors/{id}{allow read:if activeMember()||admin();allow create:if (procurementTeam())&&request.resource.data.status=="Pending Review"&&request.resource.data.registeredByUid==request.auth.uid;allow update:if procurementTeam()||(activeMember()&&resource.data.status=="Probation"&&request.resource.data.status=="Probation"&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["probationEngagements","updatedAt"])&&request.resource.data.probationEngagements==resource.data.probationEngagements+1&&request.resource.data.probationEngagements<=2);allow delete:if false;}
  match /procurementVendorScores/{id}{allow read:if procurementTeam()||admin();allow create:if procurementTeam()&&request.resource.data.vendorId is string&&request.resource.data.year is int&&request.resource.data.totalScore is number&&request.resource.data.totalScore>=0&&request.resource.data.totalScore<=10&&request.resource.data.maximumScore==10&&request.resource.data.threshold==6&&request.resource.data.performanceStatus in ["Eligible","Blacklisted"];allow update,delete:if false;}
  match /procurementVendorBlacklist/{id}{allow read:if procurementTeam()||admin();allow create:if procurementTeam()&&request.resource.data.vendorId is string&&request.resource.data.score is number&&request.resource.data.score<6&&request.resource.data.status=="Active";allow update:if procurementTeam();allow delete:if false;}
  match /procurementQuotationHashes/{hash}{allow read:if activeMember()||admin();allow create:if activeMember()&&request.resource.data.fileHash==hash&&request.resource.data.requestId is string&&exists(/databases/$(database)/documents/procurementRequests/$(request.resource.data.requestId))&&get(/databases/$(database)/documents/procurementRequests/$(request.resource.data.requestId)).data.requestedByUid==request.auth.uid;allow update,delete:if false;}
  match /procurementRequests/{id}{
    allow read:if admin()||procurementTeam()||financePersonnel()||(activeMember()&&resource.data.requestedByUid==request.auth.uid);
    allow create:if procurementTeam()&&request.resource.data.requestedByUid==request.auth.uid&&request.resource.data.status=="Quotations Required"&&request.resource.data.quotationCount==0&&exists(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId))&&((get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.status=="Approved"&&!get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.keys().hasAny(["performanceStatus"])||get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.status=="Approved"&&get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.performanceStatus!="Blacklisted")||(get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.status=="Probation"&&getAfter(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.probationEngagements<=2&&getAfter(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.probationEngagements==get(/databases/$(database)/documents/procurementVendors/$(request.resource.data.vendorId)).data.probationEngagements+1))&&request.resource.data.department is string&&request.resource.data.unit is string&&validProcurementDepartment(request.resource.data.department)&&validProcurementUnit(request.resource.data.department,request.resource.data.unit)&&request.resource.data.quotationRequiredCount is int&&((request.resource.data.procurementMethod=="Request for Quotations"&&request.resource.data.quotationRequiredCount==3)||(request.resource.data.procurementMethod=="Competitive Tender"&&request.resource.data.quotationRequiredCount>=1&&request.resource.data.quotationRequiredCount<=10)||(request.resource.data.procurementMethod in ["Direct Procurement","Framework Contract"]&&request.resource.data.quotationRequiredCount==1));
    allow update:if admin()||(procurementLocationImmutable()&&
      (procurementTeam()&&resource.data.requestedByUid==request.auth.uid&&resource.data.status=="Quotations Required"&&request.resource.data.status in ["Quotations Required","PR Registration"]&&request.resource.data.procurementMethod==resource.data.procurementMethod&&request.resource.data.quotationRequiredCount==resource.data.quotationRequiredCount&&request.resource.data.quotationCount>=resource.data.quotationCount&&request.resource.data.quotationCount<=resource.data.quotationRequiredCount&&((request.resource.data.status=="PR Registration"&&request.resource.data.quotationCount==resource.data.quotationRequiredCount)||(request.resource.data.status=="Quotations Required"&&request.resource.data.quotationCount<resource.data.quotationRequiredCount)) )||
      (procurementTeam()&&resource.data.status=="PR Registration"&&request.resource.data.status=="Procurement Review"&&exists(/databases/$(database)/documents/procurementVendors/$(resource.data.vendorId))&&get(/databases/$(database)/documents/procurementVendors/$(resource.data.vendorId)).data.status in ["Approved","Probation"])||
      (procurementTeam()&&resource.data.status=="Procurement Review"&&request.resource.data.status in ["Pending Authorization","Rejected"])||
      (procurementApprover()&&resource.data.status=="Pending Authorization"&&request.resource.data.status=="PO Generation"&&request.resource.data.requestedByUid!=request.auth.uid)||
      (procurementTeam()&&resource.data.status=="PO Generation"&&request.resource.data.status=="Delivery Note Required")||
      (procurementTeam()&&resource.data.requestedByUid==request.auth.uid&&resource.data.status=="Delivery Note Required"&&request.resource.data.status=="Invoice Required")||
      (procurementTeam()&&resource.data.requestedByUid==request.auth.uid&&resource.data.status=="Invoice Required"&&request.resource.data.status=="Finance Handoff")||
      (procurementTeam()&&resource.data.status=="Finance Handoff"&&request.resource.data.status=="Sent to Finance"));
    allow delete:if admin();
  }
  match /invitations/{id}{allow read:if admin()||(signedIn()&&resource.data.email==request.auth.token.email);allow create,update,delete:if admin();}
  match /mail/{id}{allow create:if admin()||hrManagement();allow read,update,delete:if false;}
  match /staffPaymentRequests/{id}{allow read:if admin()||financePersonnel()||management()||hrManagement()||(activeMember()&&(resource.data.employeeUid==request.auth.uid||(resource.data.involvedUids is list&&resource.data.involvedUids.hasAny([request.auth.uid]))));allow create:if activeMember()&&request.resource.data.employeeUid==request.auth.uid&&request.resource.data.status=="Submitted"&&request.resource.data.workflowStage=="HR/Administrative Verification";allow update:if admin()||(hrManagement()&&resource.data.workflowStage=="HR/Administrative Verification"&&request.resource.data.workflowStage in ["HR/Administrative Verification","Finance Verification"])||(financePersonnel()&&resource.data.workflowStage in ["Finance Verification","Payment Processing"]&&request.resource.data.workflowStage in ["Finance Verification","Executive Authorization","Payment Processing","Completed","Returned","Rejected"])||(role("Executive Director")&&resource.data.workflowStage=="Executive Authorization"&&request.auth.uid!=resource.data.employeeUid&&request.resource.data.workflowStage in ["Payment Processing","Returned","Rejected"])||(activeMember()&&resource.data.employeeUid==request.auth.uid&&resource.data.status in ["Draft","Returned"]&&request.resource.data.status=="Submitted"&&request.resource.data.workflowStage=="HR/Administrative Verification");allow delete:if admin();}
  match /documents/{id}{allow read:if governanceUser();allow create,delete:if admin();allow update:if admin()||signatureDocumentWorkflowUpdate();}
  match /signatureProfiles/{uid}{allow read:if admin()||self(uid);allow create,update:if self(uid)||admin();allow delete:if false;}
  match /signatureEnvelopes/{id}{allow read:if admin()||(signedIn()&&resource.data.participantUids is list&&resource.data.participantUids.hasAny([request.auth.uid]));allow create:if admin()||activeMember();allow update:if admin()||(activeMember()&&resource.data.participantUids is list&&resource.data.participantUids.hasAny([request.auth.uid])&&request.resource.data.envelopeReference==resource.data.envelopeReference&&request.resource.data.senderUid==resource.data.senderUid&&request.resource.data.documentId==resource.data.documentId&&request.resource.data.participantUids==resource.data.participantUids&&request.resource.data.lastSignedByUid==request.auth.uid);allow delete:if false;}
  match /signatureEvents/{id}{allow read:if admin()||(signedIn()&&resource.data.actorUid==request.auth.uid);allow create:if (admin()||activeMember())&&request.resource.data.actorUid==request.auth.uid;allow update,delete:if false;}
  match /signatures/{id}{allow read:if admin()||(signedIn()&&resource.data.signerUid==request.auth.uid);allow create:if admin()||(activeMember()&&request.resource.data.signerUid==request.auth.uid);allow update,delete:if false;}
  match /votingIssues/{id}{allow read:if governanceUser();allow create,update:if admin();allow delete:if false;}
  match /votingIssues/{issueId}/participants/{uid}{allow read:if self(uid);allow create:if activeMember()&&uid==request.auth.uid&&request.resource.data.uid==request.auth.uid&&request.resource.data.issueId==issueId&&!exists(/databases/$(database)/documents/votingIssues/$(issueId)/participants/$(uid))&&get(/databases/$(database)/documents/votingIssues/$(issueId)).data.status=="Open";allow update,delete:if false;}
  match /votes/{id}{allow read:if governanceUser();allow create:if activeMember()&&request.resource.data.anonymous==true&&request.resource.data.meetingId is string&&request.resource.data.votingIssueId is string&&request.resource.data.votingReference is string&&request.resource.data.votingReference.size()>0&&request.resource.data.outcome in ["For","Against","Abstain"]&&!request.resource.data.keys().hasAny(["voterUid","voterEmail"])&&exists(/databases/$(database)/documents/meetings/$(request.resource.data.meetingId))&&exists(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId))&&get(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId)).data.meetingId==request.resource.data.meetingId&&get(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId)).data.resolutionId==request.resource.data.resolutionId&&getAfter(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId)).data.status=="Open"&&getAfter(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId)/participants/$(request.auth.uid)).data.uid==request.auth.uid&&getAfter(/databases/$(database)/documents/votingIssues/$(request.resource.data.votingIssueId)/participants/$(request.auth.uid)).data.issueId==request.resource.data.votingIssueId;allow update,delete:if false;}
  match /voteCorrections/{id}{allow read:if admin();allow create:if admin()&&request.resource.data.voteId is string&&exists(/databases/$(database)/documents/votes/$(request.resource.data.voteId))&&request.resource.data.originalVotePreserved==true&&request.resource.data.auditRequired==true;allow update,delete:if false;}
  match /voteLocks/{id}{allow read:if false;allow create,update:if false;allow delete:if false;}
  match /audit/{id}{allow read:if admin();allow create:if signedIn();allow update,delete:if false;}
  match /participants/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /meetings/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /meetingSubscriptions/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /meetingRoomEvents/{id}{allow read:if governanceUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /transcriptions/{id}{allow read:if governanceUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /resolutions/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /actions/{id}{allow read:if governanceUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /decisions/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /risks/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /reports/{id}{allow read:if governanceUser();allow create,update,delete:if admin()||management();}
  match /financeBudgets/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /financeTransactions/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()||(procurementTeam()&&request.resource.data.sourceModule=="Procurement"&&request.resource.data.status=="Pending Approval"&&request.resource.data.procurementRequestId is string);allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /financePaymentTrace/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()||(procurementTeam()&&request.resource.data.sourceModule=="Procurement"&&request.resource.data.handoffStatus=="Handoff Received"&&request.resource.data.authorizationStatus=="Authorized"&&request.resource.data.financeTransactionId is string);allow update:if financePersonnel();allow delete:if false;}
  match /financeFunding/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeApprovals/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /financeCommitments/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeGrants/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeBankAccounts/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeReconciliations/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /financeAssets/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeRisks/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeReports/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /authorizationRequests/{id}{allow read:if admin()||workflowParticipant(resource);allow create:if admin()||activeMember();allow update:if admin()||workflowParticipant(resource)||workflowParticipant(request.resource);allow delete:if admin();}
  match /workflowActions/{id}{allow read:if admin()||workflowParticipant(resource);allow create:if admin()||activeMember()&&validAuthorizationCreate();allow update:if workflowUpdateAllowed()&&validWorkflowRecord(request.resource)&&!workflowTerminal()&&(request.resource.data.workflowType!="Authorization"||authorizationTransitionAllowed());allow delete:if admin();}
  match /systemSettings/{id}{allow read,create,update,delete:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}