rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminProfileExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/adminProfiles/$(request.auth.uid)
        );
    }

    function admin() {
      return adminProfileExists()
        && get(
          /databases/$(database)/documents/adminProfiles/$(request.auth.uid)
        ).data.active == true;
    }

    function self(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function memberProfileExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/members/$(request.auth.uid)
        );
    }

    function activeMember() {
      return memberProfileExists()
        && get(
          /databases/$(database)/documents/members/$(request.auth.uid)
        ).data.status == "Active";
    }

    function governanceUser() {
      return admin() || activeMember();
    }


    match /adminProfiles/{uid} {

      allow read: if self(uid) || admin();

      allow create: if admin();

      allow update: if admin()
        && uid != request.auth.uid;

      allow delete: if false;
    }


    match /members/{id} {

      allow read: if admin()
        || self(id);

      allow create: if admin()
        || (
          signedIn()
          && request.resource.data.uid == request.auth.uid
        );

      allow update: if admin()
        || (
          self(id)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if admin();
    }


    match /invitations/{id} {

      allow read: if admin()
        || (
          signedIn()
          && resource.data.email == request.auth.token.email
        );

      allow create, update, delete: if admin();
    }


    match /documents/{id} {

      allow read: if governanceUser()
        && (
          admin()
          || (
            resource.data.authorizedUids is list
            && resource.data.authorizedUids.hasAny(
              [request.auth.uid]
            )
          )
        );

      allow create, update, delete: if admin();
    }


    match /signatures/{id} {

      allow read: if admin()
        || (
          signedIn()
          && resource.data.signerUid == request.auth.uid
        );

      allow create: if admin()
        || (
          activeMember()
          && request.resource.data.signerUid == request.auth.uid
        );

      allow update: if admin()
        || (
          activeMember()
          && resource.data.signerUid == request.auth.uid
          && request.resource.data.signerUid == request.auth.uid
        );

      allow delete: if false;
    }


    match /votes/{id} {

      allow read: if governanceUser();

      allow create: if activeMember()
        && request.resource.data.voterUid == request.auth.uid;

      allow update, delete: if false;
    }


    match /voteLocks/{id} {

      allow read: if governanceUser();

      allow create, update: if admin();

      allow delete: if false;
    }


    match /audit/{id} {

      allow read: if admin();

      allow create: if signedIn();

      allow update, delete: if false;
    }


    match /participants/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /meetings/{id} {
      allow read: if governanceUser();
      allow create, update, delete: if admin();
    }


    match /meetingSubscriptions/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /meetingRoomEvents/{id} {
      allow read: if governanceUser();
      allow create, update: if governanceUser();
      allow delete: if admin();
    }


    match /transcriptions/{id} {
      allow read: if governanceUser();
      allow create, update: if governanceUser();
      allow delete: if admin();
    }


    match /resolutions/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /actions/{id} {
      allow read: if governanceUser();
      allow create, update: if governanceUser();
      allow delete: if admin();
    }


    match /decisions/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /risks/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /reports/{id} {
      allow read: if governanceUser();
      allow create, update: if admin();
      allow delete: if admin();
    }


    match /financeBudgets/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeTransactions/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeFunding/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeApprovals/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeCommitments/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeGrants/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeBankAccounts/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeReconciliations/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeAssets/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeRisks/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /financeReports/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /systemSettings/{id} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
