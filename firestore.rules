  function meetingParticipant(data){return signedIn()&&(data.get("initiatorUid","")==request.auth.uid||data.get("createdByUid","")==request.auth.uid||data.get("chairpersonUid","")==request.auth.uid||data.get("secretaryUid","")==request.auth.uid||(data.get("participantUids",[]) is list&&data.get("participantUids",[]).hasAny([request.auth.uid]))||(data.get("attendeeUids",[]) is list&&data.get("attendeeUids",[]).hasAny([request.auth.uid]))||(data.get("memberUids",[]) is list&&data.get("memberUids",[]).hasAny([request.auth.uid]))||(data.get("invitedUids",[]) is list&&data.get("invitedUids",[]).hasAny([request.auth.uid]))||(data.get("subscriberUids",[]) is list&&data.get("subscriberUids",[]).hasAny([request.auth.uid]))||(request.auth.token.email is string&&(data.get("participantEmails",[]) is list&&data.get("participantEmails",[]).hasAny([request.auth.token.email]))||(data.get("attendeeEmails",[]) is list&&data.get("attendeeEmails",[]).hasAny([request.auth.token.email]))||(data.get("invitedEmails",[]) is list&&data.get("invitedEmails",[]).hasAny([request.auth.token.email]))||(data.get("subscriberEmails",[]) is list&&data.get("subscriberEmails",[]).hasAny([request.auth.token.email]))));}
  function meetingCategoryReadAllowed(data){return admin()||(signedIn()&&data.get("initiatorUid","")==request.auth.uid)||meetingParticipant(data)||(meetingCategoryIs(data,"GOVERNANCE",["Governance","Board","Board Meeting","Board Committee Meeting","Annual General Meeting","Special Meeting"])&&anyInstitutionalRole(["Board Member","Board Chairperson","Board Secretary","Secretary to the Board","Executive Director","Director Internal Oversight"]))||(meetingCategoryIs(data,"ADMINISTRATIVE",["Administrative","Management","Management Meeting","Administration Meeting","Operations Meeting"])&&anyInstitutionalRole(["Executive Director","Director Finance & Administration","Director Human Resources","HR Director","Operations Manager","Departmental Director","Departmental Manager","Director Outreach","Director Community Development","Director Livestock","Director Environment","Director Field Department"]))||(meetingCategoryIs(data,"STAFF",["Staff","Staff Meeting"])&&anyInstitutionalRole(["Executive Director","Director Human Resources","HR Director","Operations Manager","Departmental Director","Departmental Manager","Employee","Staff"]))||(meetingCategoryIs(data,"GENERAL",["General","General Meeting"])&&(activeMember()||activeEmployee()||anyInstitutionalRole(["Executive Director","Departmental Director","Departmental Manager","Board Member"])))||(meetingCategoryIs(data,"OTHER",["Other","Other Meeting"])&&anyInstitutionalRole(["Executive Director","Departmental Director","Departmental Manager","Operations Manager"]));}
  function meetingSessionController(data){return signedIn()&&(admin()||data.get("initiatorUid","")==request.auth.uid||data.get("chairpersonUid","")==request.auth.uid||data.get("secretaryUid","")==request.auth.uid||(request.auth.token.email is string&&(data.get("initiatorEmail","")==request.auth.token.email||data.get("chairpersonEmail","")==request.auth.token.email||data.get("secretaryEmail","")==request.auth.token.email)));}
  function meetingSessionUpdateAllowed(data){return meetingSessionController(data)&&data.get("registerStatus","")=="Registered"&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","proceedingsStatus","quorumRequired","quorumVerified","quorumVerifiedAt","closedAt","currentAgendaItem","currentAgendaItemIndex","currentAgendaItemStatus","currentMotion","transcript","votingRequired","votingReference","votingIssueId","votingStatus","votingResult","actionItems","actionId","actionReference","decisionId","decisionReference","signingFields","signingFieldSetVersion","updatedAt","updatedByUid","updatedByEmail"]);}
  match /meetings/{id}{allow read:if meetingCategoryReadAllowed(resource.data);allow create:if meetingRegistrar()&&request.resource.data.get("initiatorUid","")==request.auth.uid&&validMeetingCategory(request.resource.data);allow update:if admin()||completeInitialMeetingRegistration()||meetingSessionUpdateAllowed(resource.data);allow delete:if admin();}
  match /meetingSubscriptions/{id}{allow read:if meetingUser();allow create,update,delete:if admin();}
  match /meetingRoomEvents/{id}{allow read:if meetingUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /transcriptions/{id}{allow read:if meetingUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /resolutions/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /actions/{id}{allow read:if governanceUser();allow create,update:if governanceUser();allow delete:if admin();}
  match /decisions/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /risks/{id}{allow read:if governanceUser();allow create,update,delete:if admin();}
  match /reports/{id}{allow read:if governanceUser();allow create,update,delete:if admin()||management();}
  match /financeChartOfAccounts/{id}{allow read:if financePortfolioViewer();allow create,update:if financePersonnel();allow delete:if admin()||financeApprovalOfficer();}
  match /financeJournalBatches/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()&&request.resource.data.status=="Draft"&&request.resource.data.workflowStage=="Draft"&&request.resource.data.postingStatus=="Unposted"&&request.resource.data.totalDebit is number&&request.resource.data.totalCredit is number&&request.resource.data.totalDebit==request.resource.data.totalCredit;allow update:if financePersonnel()&&resource.data.status!="Posted"&&request.resource.data.status in ["Draft","Submitted for Approval"]&&request.resource.data.totalDebit is number&&request.resource.data.totalCredit is number&&request.resource.data.totalDebit==request.resource.data.totalCredit;allow delete:if (admin()||financeApprovalOfficer())&&resource.data.status=="Draft";}
  match /financePeriods/{id}{allow read:if financePortfolioViewer();allow create,update:if financePersonnel();allow delete:if admin();}
  match /financeLedgerJournals/{id}{allow read:if financePortfolioViewer();allow create,update,delete:if false;}
  match /financeLedgerEntries/{id}{allow read:if financePortfolioViewer();allow create,update,delete:if false;}
  match /financePaymentMatches/{id}{allow read:if financePortfolioViewer();allow create,update:if financePersonnel();allow delete:if false;}

  match /financeBudgets/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()&&financialReferenceFieldsNotSupplied();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer())&&financialReferenceFieldsImmutable();allow delete:if financePersonnel();}
  match /financeTransactions/{id}{allow read:if financePortfolioViewer();allow create:if (financePersonnel()||(procurementTeam()&&request.resource.data.sourceModule=="Procurement"&&request.resource.data.status=="Pending Approval"&&request.resource.data.procurementRequestId is string))&&financialReferenceFieldsNotSupplied();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer())&&financialReferenceFieldsImmutable();allow delete:if financePersonnel();}
  match /financePaymentTrace/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()||(procurementTeam()&&request.resource.data.sourceModule=="Procurement"&&request.resource.data.handoffStatus=="Handoff Received"&&request.resource.data.authorizationStatus=="Authorized"&&request.resource.data.financeTransactionId is string);allow update:if financePersonnel();allow delete:if false;}
  match /financeReferenceRegistry/{id}{allow read:if financePortfolioViewer();allow create,update,delete:if false;}
  match /financeFunding/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeApprovals/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()&&financialReferenceFieldsNotSupplied();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer())&&financialReferenceFieldsImmutable();allow delete:if financePersonnel();}
  match /financeCommitments/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeGrants/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeBankAccounts/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeReconciliations/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer());allow delete:if financePersonnel();}
  match /financeAssets/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeRisks/{id}{allow read,create,update,delete:if financePersonnel();}
  match /financeReports/{id}{allow read:if financePortfolioViewer();allow create:if financePersonnel()&&financialReferenceFieldsNotSupplied();allow update:if financePersonnel()&&(request.resource.data.status==resource.data.status||financeApprovalOfficer())&&financialReferenceFieldsImmutable();allow delete:if financePersonnel();}
  match /authorizationRequests/{id}{allow read:if admin()||authorizationParticipant(resource);allow create:if admin()||authorizationUser();allow update:if admin()||authorizationParticipant(resource)||authorizationParticipant(request.resource);allow delete:if admin();}
  match /workflowActions/{id}{allow read:if admin()||(resource.data.workflowType=="Authorization"&&authorizationParticipant(resource))||workflowParticipant(resource);allow create:if admin()||validAuthorizationCreate();allow update:if admin()||((resource.data.workflowType=="Authorization"&&authorizationParticipant(resource))||workflowParticipant(resource))&&validWorkflowRecord(request.resource)&&!workflowTerminal()&&(request.resource.data.workflowType!="Authorization"||authorizationTransitionAllowed());allow delete:if admin();}
  // Grant Intelligence: authenticated profiles may read opportunities; designated management roles publish and update them.
  match /grantOpportunities/{id}{
    allow read: if signedIn();
    allow create, update: if admin() || anyInstitutionalRole(["Executive Director","Director Outreach","Director Finance & Administration","Director Research","Research Director","Research Manager","Research Officer","Fundraising Officer"]);
    allow delete: if admin();
  }
  // Grant crawler telemetry is visible to authenticated IRPA profiles; only trusted server functions write crawler status.
  match /grantCrawlerStatus/{id}{allow read:if signedIn();allow write:if false;}
  match /grantCrawlerSources/{id}{allow read:if signedIn();allow write:if false;}
  match /grantCrawlerRuns/{id}{allow read:if signedIn()&&(admin()||anyInstitutionalRole(["Executive Director","Director Outreach","Director Finance & Administration","Director Research","Research Director","Research Manager","Research Officer","Fundraising Officer"]));allow write:if false;}
  match /systemSettings/{id}{allow read,create,update,delete:if admin();}
  match /systemSettings/documentCounters{
    allow get:if signedIn();
    allow create:if signedIn()&&request.resource.data.documentReference==1&&request.resource.data.keys().hasOnly(["documentReference","updatedAt"]);
    allow update:if signedIn()&&resource.data.documentReference is int&&request.resource.data.documentReference==resource.data.documentReference+1&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["documentReference","updatedAt"]);
    allow delete:if admin();
  }
  match /documentReferenceRegistry/{id}{
    allow create:if signedIn()&&request.resource.data.referenceNumber==id&&request.resource.data.sequenceNumber is int&&request.resource.data.sequenceNumber>0&&request.resource.data.issuedByUid==request.auth.uid&&request.resource.data.controlStatus=="Active"&&getAfter(/databases/$(database)/documents/systemSettings/documentCounters).data.documentReference==request.resource.data.sequenceNumber;
    allow get:if signedIn();
    allow update,delete:if admin();
  }
  match /inductionRecords/{uid}{allow read:if self(uid)||admin();allow create,update:if self(uid)&&request.resource.data.uid==request.auth.uid&&(activeMember()||request.auth.token.firebase.sign_in_provider=="anonymous");allow delete:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}