// ============================================================================
// 🔴🔴🔴 RED-LINE POLICY — NON-NEGOTIABLE 🔴🔴🔴
//
// EVERY WRITTEN WORD IN THE ENTIRE IRPA-DBGS WEB APP MUST REMAIN
// VISIBLE, CLEAR AND READABLE.
//
// NO TEXT MAY BE:
//   1. HIDDEN, OBSCURED OR MADE TRANSPARENT;
//   2. PLACED ON A BACKGROUND THAT HINDERS ITS READABILITY;
//   3. STYLED SO THAT RECORDS, LABELS, HEADINGS OR VALUES CANNOT
//      BE READ CLEARLY.
//
// SCOPE: EVERY PORTAL, REGISTER, FORM, TABLE, PANEL, CARD, DIALOG,
// STATUS AREA, DESKTOP VIEW, MOBILE VIEW AND CAPACITOR APP VIEW.
//
// 🔴 THIS IS A BINDING APPLICATION/UI REQUIREMENT. 🔴
//
// Firestore Rules control data access/validation and cannot directly
// style CSS. Enforcement of this rule must therefore also exist in
// application markup/CSS and CI checks.
// ============================================================================

rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function self(uid){return signedIn()&&request.auth.uid==uid;}
  function primaryAdmin(){return signedIn()&&(request.auth.token.get("admin",false)==true||request.auth.token.get("email","")=="irpa2412@gmail.com");}
  function adminProfileExists(){return signedIn()&&exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid));}
  function admin(){return primaryAdmin()||(adminProfileExists()&&get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.active==true);}
  function memberProfileExists(){return signedIn()&&exists(/databases/$(database)/documents/members/$(request.auth.uid));}
  function activeMember(){return memberProfileExists()&&((get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("status","") in ["Active","Activated"])||get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("registrationStatus","")=="Activated");}
  function activeEmployee(){return signedIn()&&exists(/databases/$(database)/documents/employees/$(request.auth.uid))&&(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("status","")=="Active"||get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("employmentStatus","")=="Active"||get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("registrationStatus","")=="Activated");}
  function procurementRequester(){return activeMember()||activeEmployee();}
  function signatureProfileOwner(){return signedIn()&&self(request.auth.uid)&&request.auth.token.email is string;} function signatureProfileUser(){return signatureProfileOwner();}
  function meetingUser(){return admin()||activeMember()||activeEmployee();}
  function meetingRegistrar(){return admin()||anyInstitutionalRole(["Executive Director","Director Internal Oversight","Director Finance & Administration","Director Human Resources","HR Director","Operations Manager","Departmental Director","Departmental Manager","Director Outreach","Director Community Development","Director Livestock","Director Environment","Director Field Department","Board Secretary","Secretary to the Board","Meeting Secretary"]);}
  function validMeetingCategory(data){return data.get("meetingCategory","OTHER") in ["GOVERNANCE","ADMINISTRATIVE","STAFF","GENERAL","OTHER"]&&data.get("meetingPolicyId",data.get("meetingCategory","OTHER")) in ["GOVERNANCE","ADMINISTRATIVE","STAFF","GENERAL","OTHER"];}
  function completeInitialMeetingRegistration(){return signedIn()&&meetingRegistrar()&&resource.data.get("registerStatus","")!="Registered"&&request.resource.data.get("registerStatus","")=="Registered"&&resource.data.get("initiatorUid","")==request.auth.uid&&request.resource.data.get("initiatorUid","")==request.auth.uid&&validMeetingCategory(request.resource.data);}
  function role(r){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role==r;}
  function anyMemberRole(roles){return signedIn()&&((request.auth.token.irpaRoles is list&&request.auth.token.irpaRoles.hasAny(roles))||(activeMember()&&roles.hasAny([get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role])));}
  function anyInstitutionalRole(roles){return signedIn()&&((activeMember()&&recordHasRole(get(/databases/$(database)/documents/members/$(request.auth.uid)).data,roles))||(activeEmployee()&&recordHasRole(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data,roles))||(request.auth.token.irpaRoles is list&&request.auth.token.irpaRoles.hasAny(roles)));}
  function auditor(){return signedIn()&&exists(/databases/$(database)/documents/auditorProfiles/$(request.auth.token.email))&&get(/databases/$(database)/documents/auditorProfiles/$(request.auth.token.email)).data.active==true&&get(/databases/$(database)/documents/auditorProfiles/$(request.auth.token.email)).data.email==request.auth.token.email;}
  function governanceUser(){return admin()||activeMember();}
  function recordHasRole(record,roles){return record.get("role","") in roles||(record.get("roles",[]) is list&&record.get("roles",[]).hasAny(roles))||(record.get("assignedRoles",[]) is list&&record.get("assignedRoles",[]).hasAny(roles))||(record.get("selectedRoles",[]) is list&&record.get("selectedRoles",[]).hasAny(roles));}
  function researchAuthority(){return admin()||(activeMember()&&recordHasRole(get(/databases/$(database)/documents/members/$(request.auth.uid)).data,["Director Research","Research Director","Research Manager","Research Officer","Research, Statistics & Knowledge Officer"]))||(activeEmployee()&&recordHasRole(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data,["Director Research","Research Director","Research Manager","Research Officer","Research, Statistics & Knowledge Officer"]));}
  function researchUser(){return researchAuthority();}
  function researchToolAllowed(tool,studyId,uid){return admin()|| (exists(path("/databases/"+database+"/documents/researchToolPermissions/"+uid+"_"+tool+"_"+studyId))&&get(path("/databases/"+database+"/documents/researchToolPermissions/"+uid+"_"+tool+"_"+studyId)).data.get("status","")=="Active");}
  function researchRequestOwner(requestId,uid){return exists(/databases/$(database)/documents/researchInformationRequests/$(requestId))&&get(/databases/$(database)/documents/researchInformationRequests/$(requestId)).data.get("requestedByUid","")==uid;}
  function researchGrantRecipient(grantId,uid){return exists(/databases/$(database)/documents/researchInformationGrants/$(grantId))&&get(/databases/$(database)/documents/researchInformationGrants/$(grantId)).data.get("status","")=="Active"&&get(/databases/$(database)/documents/researchInformationGrants/$(grantId)).data.get("grantedToUid","")==uid;}
  function researchPortalReviewer(portal){
    return admin() ||
      (portal=="Finance Portfolio" && anyInstitutionalRole(["Executive Director","Director Finance & Administration","Finance Manager","Finance Officer","Accountant"])) ||
      (portal=="Procurement" && anyInstitutionalRole(["Executive Director","Director Finance & Administration","Finance Manager","Procurement Officer","Procurement Manager","Procurement Team Member"])) ||
      (portal=="Human Resources" && anyInstitutionalRole(["Executive Director","Director Human Resources","HR Manager","HR Officer"])) ||
      (portal=="Livestock" && anyInstitutionalRole(["Executive Director","Director Livestock","Livestock Director","Livestock Officer"])) ||
      (portal=="Environment & Rangeland" && anyInstitutionalRole(["Executive Director","Director Environment","Environment Director","Environment Officer","Rangeland Officer"])) ||
      (portal=="Outreach & Community Development" && anyInstitutionalRole(["Executive Director","Director Outreach","Outreach Director","Outreach Officer","Director Community Development","Community Development Director","Community Development Officer"])) ||
      (portal=="Field Operations" && anyInstitutionalRole(["Executive Director","Director Field","Director Field Operations","Field Director","Field Assistant"])) ||
      (portal=="Operations" && anyInstitutionalRole(["Executive Director","Director Operations","Operations Director","Operations Manager"])) ||
      (portal=="Information Technology" && anyInstitutionalRole(["Executive Director","IT Specialist","Information Technology Officer"])) ||
      (portal=="Internal Oversight" && anyInstitutionalRole(["Executive Director","Director Internal Oversight","Internal Oversight Director","Internal Oversight Officer"])) ||
      (portal=="Members & Personnel" && anyInstitutionalRole(["Executive Director","Director Human Resources","HR Manager"])) ||
      (portal=="Meetings" && anyInstitutionalRole(["Executive Director","Board Secretary","Board Chairperson","Board Vice Chairperson"])) ||
      (portal=="Documents" && anyInstitutionalRole(["Executive Director","Director Internal Oversight","Director Finance & Administration"])) ||
      (portal=="Reports" && anyInstitutionalRole(["Executive Director","Director Internal Oversight","Director Finance & Administration","Director Human Resources"]));
  }
  function authorityRoleRegistered(record,authorityRole){return record.get("role","")==authorityRole||record.get("boardPosition","")==authorityRole||record.get("unit","")==authorityRole||record.get("unitName","")==authorityRole||(record.get("roles",[]) is list&&record.get("roles",[]).hasAny([authorityRole]))||(record.get("assignedRoles",[]) is list&&record.get("assignedRoles",[]).hasAny([authorityRole]))||(record.get("selectedRoles",[]) is list&&record.get("selectedRoles",[]) .hasAny([authorityRole]))||(record.get("roleAssignments",[]) is list&&record.get("roleAssignments",[]).hasAny([authorityRole]));}
  function signerIdentityAuthorityUnchanged(){return request.resource.data.get("authorityRole",null)==resource.data.get("authorityRole",null)&&request.resource.data.get("authorityStatus",null)==resource.data.get("authorityStatus",null)&&request.resource.data.get("authorityReference",null)==resource.data.get("authorityReference",null)&&request.resource.data.get("authorityEffectiveAt",null)==resource.data.get("authorityEffectiveAt",null)&&request.resource.data.get("authorityExpiresAt",null)==resource.data.get("authorityExpiresAt",null)&&request.resource.data.get("authorityDepartment",null)==resource.data.get("authorityDepartment",null)&&request.resource.data.get("authorityUnit",null)==resource.data.get("authorityUnit",null)&&request.resource.data.get("authoritySourceCollection",null)==resource.data.get("authoritySourceCollection",null)&&request.resource.data.get("authoritySourceRecordId",null)==resource.data.get("authoritySourceRecordId",null);}
  function signerAuthorityUpdateAllowed(uid){return self(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.signerProfileId==resource.data.signerProfileId&&request.resource.data.get("authorityRole","") is string&&request.resource.data.get("authorityRole","")!=""&&request.resource.data.get("authorityStatus","") in ["Current","Pending Verification","Expired","Not yet assigned"]&&request.resource.data.get("authorityDepartment","") is string&&request.resource.data.get("authorityUnit","") is string&&authorityRegisterMatch(request.resource.data.get("authorityDepartment",""),request.resource.data.get("authorityUnit",""),request.resource.data.get("authorityRole",""));}
  function authorityRegisterMatch(department,unit,authorityRole){
    return (exists(/databases/$(database)/documents/members/$(request.auth.uid))&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("status","")=="Active"&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("department","")==department&&(get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("unit","")==unit||get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("unitName","")==unit||unit==get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("department",""))&&authorityRoleRegistered(get(/databases/$(database)/documents/members/$(request.auth.uid)).data,authorityRole))
    ||(exists(/databases/$(database)/documents/employees/$(request.auth.uid))&&(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("status","")=="Active"||get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("employmentStatus","")=="Active")&&get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("department","")==department&&(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("unit","")==unit||get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("unitName","")==unit||unit==get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get("department",""))&&authorityRoleRegistered(get(/databases/$(database)/documents/employees/$(request.auth.uid)).data,authorityRole));
  }
  function financeDepartmentMember(){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department=="Finance & Administration"&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unit in ["Finance Unit","Accounting Unit"];}function procurementDepartmentMember(){return activeMember()&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department=="Finance & Administration"&&get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unit=="Procurement Unit";}function financePersonnel(){return admin()||financeDepartmentMember()||anyMemberRole(["Finance Personnel","Finance Manager","Accountant","Finance Officer","Executive Director","Director Finance & Administration"]);}
  function financeOversight(){return admin()||anyMemberRole(["Executive Director","Director Internal Oversight","Internal Oversight Officer"]);}
  function financeApprovalOfficer(){return admin()||anyMemberRole(["Executive Director","Director Finance & Administration","Finance Manager","Accountant","Finance Officer"]);}function financePortfolioViewer(){return financePersonnel()||financeApprovalOfficer();}
  function financialReferenceFieldsImmutable(){return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["referenceNumber","referenceStatus","referenceIssuedAt","referenceIssuedBy","financialReferenceVersion"]);}
  function financialReferenceFieldsNotSupplied(){return !request.resource.data.keys().hasAny(["referenceNumber","referenceStatus","referenceIssuedAt","referenceIssuedBy","financialReferenceVersion"]);}
  function procurementTeam(){return admin()||procurementDepartmentMember()||anyMemberRole(["Procurement Officer","Procurement Manager","Procurement Team Member"]);}
  function procurementApprover(){return admin()||anyMemberRole(["Executive Director","Director Livestock","Livestock Director","Director Internal Oversight","Internal Oversight Director","Director Finance & Administration","Director Human Resources","Director Outreach","Director Community Development","Director Environment","Director Field","Director Operations","Operations Director","Outreach Director","Community Development Director","Environment Director","Field Director"]);}
  function validProcurementDepartment(d){return d in ["Executive Office","Internal Oversight","Governance","Livestock Development","Environment & Sustainable Rangeland Management","Finance & Administration","Human Resources","Outreach","Community Development","Field Department","Operations"];}
  function validProcurementUnit(d,u){return (d=="Governance"&&u in ["Governance Unit","Board Governance Unit"])||(d=="Executive Office"&&u in ["Executive Director's Office","Management Coordination Unit"])||(d=="Internal Oversight"&&u in ["Internal Oversight Unit","Compliance & Assurance Unit"])||(d=="Livestock Development"&&u in ["Livestock Production Unit","Veterinary Services Unit","Breeding & Genetics Unit","Livestock Infrastructure Unit"])||(d=="Environment & Sustainable Rangeland Management"&&u in ["Rangeland Management Unit","Rangeland Restoration Unit","Invasive Species Control Unit","Climate Change & Resilience Unit","Environmental Conservation & Education Unit"])||(d=="Finance & Administration"&&u in ["Finance Unit","Accounting Unit","Administration Unit","Procurement Unit"])||(d=="Human Resources"&&u in ["Human Resources & Staff Welfare Unit","Training & Capacity Development Unit","Personnel & Records Unit"])||(d=="Outreach"&&u in ["Communications & Outreach Unit","Partnerships & Resource Mobilization Unit","ICT & Digital Engagement Unit"])||(d=="Community Development"&&u in ["Community Mobilization Unit","Women & Youth Empowerment Unit","Gender & Social Inclusion Unit"])||(d=="Field Department"&&u in ["Field Implementation Unit","Monitoring, Evaluation, Accountability & Learning Unit","Community-Based Monitoring Unit"])||(d=="Operations"&&u in ["Logistics & Transport Unit","Infrastructure & Facilities Unit","General Operations Unit"]);}
  function procurementLocationImmutable(){return request.resource.data.department==resource.data.department&&request.resource.data.unit==resource.data.unit;}
  function management(){return admin()||anyMemberRole(["Executive Director","Management","Finance Manager","Director Internal Oversight"]);}
  function hrManagement(){return admin()||anyMemberRole(["Executive Director","Director Human Resources","HR Manager"]);}
  function authorizationUser(){return admin()||activeMember()||activeEmployee();}
  function authorizationParticipant(d){return authorizationUser()&&d.involvedUids is list&&d.involvedUids.hasAny([request.auth.uid]);}
  function workflowParticipant(d){return governanceUser()&&d.involvedUids is list&&d.involvedUids.hasAny([request.auth.uid]);}
  function validWorkflowStatus(s){return s in ["Draft","Submitted","Under Review","Approved","Rejected","Returned","Completed","Evaluation","Ordered","Cancelled","Authorized","Superseded","Archived","Pending Signature","Signed","Declined","Expired","In Implementation","Implemented"];}
  function validWorkflowRecord(d){return d.workflowType is string&&d.module is string&&d.status is string&&validWorkflowStatus(d.status)&&d.stageIndex is int&&d.stageIndex>=0&&d.involvedUids is list;}
  function workflowUpdateAllowed(){return admin()||workflowParticipant(resource)||workflowParticipant(request.resource);}
  function workflowTerminal(){return resource.data.status in ["Completed","Rejected","Cancelled","Archived","Superseded","Signed","Declined","Expired","Implemented"];}
  function signatureDocumentWorkflowUpdate(){return activeMember()&&resource.data.signatureEnvelopeId is string&&getAfter(/databases/$(database)/documents/signatureEnvelopes/$(resource.data.signatureEnvelopeId)).data.participantUids is list&&getAfter(/databases/$(database)/documents/signatureEnvelopes/$(resource.data.signatureEnvelopeId)).data.participantUids.hasAny([request.auth.uid])&&request.resource.data.signatureEnvelopeId==resource.data.signatureEnvelopeId&&request.resource.data.signatureOwnerUid==resource.data.signatureOwnerUid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signatureEnvelopeId","signatureReference","signatureStatus","signatureOwnerUid","workflowOwnerSectionSaved","workflowActionStatus","lastWorkflowAction","lastWorkflowActionUid","lastWorkflowActionAt","authorizationStatus","completedDocumentUrl","ownerCompletedDocumentUrl","ownerCompletedDocumentPath","ownerRecordStatus","lastCompletedDocumentHash","documentArchiveUid","documentArchiveFolderId","documentArchiveUidLink","documentArchivePath","documentArchiveAccess","governanceArchiveFolderId","governanceArchiveUidLink","governanceArchivePath","governanceArchiveSignedUrl","documentCustodianUid","documentCustodianRole","documentCustodyStatus","documentCustodyAssignedAt","documentClassification","updatedAt"])&&(request.auth.uid==resource.data.signatureOwnerUid||request.resource.data.lastWorkflowActionUid==request.auth.uid);}
  function signatureEnvelopeAdminUpdate(){
    return admin()&&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSignedByUid","lastSignedAt","signedDocumentPath","signedDocumentUrl","ownerCompletedDocumentPath","ownerCompletedDocumentUrl","ownerRecordStatus","originalDocumentHash","latestDocumentHash","workflowHistory","currentSignerUid","completedAt","documentCustodianUid","documentCustodianRole","documentCustodyStatus","documentCustodyAssignedAt"])&&
      request.resource.data.status in ["Draft","Sent","In Progress","Shared","Cancelled"];
  }
  function signatureEnvelopeSignerUpdate(){
    return signedIn()&&
      resource.data.participantUids is list&&resource.data.participantUids.hasAny([request.auth.uid])&&
      resource.data.get("actionUids",[]) is list&&resource.data.get("actionUids",[]).hasAny([request.auth.uid])&&
      ((resource.data.get("signingMode","Sequential")=="Sequential"&&resource.data.get("currentSignerUid",null)==request.auth.uid)||
       resource.data.get("signingMode","Sequential")=="Parallel")&&
      request.resource.data.lastSignedByUid==request.auth.uid&&
      request.resource.data.status in ["In Progress","Completed"]&&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["senderUid","ownerUid","ownerEmail","participantUids","actionUids","recipients","fields","documentId","documentUrl","documentReference"]);
  }
  function authorizationReviewerRole(uid){return (exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.get("role","") in ["Director Internal Oversight","Internal Oversight Officer","Director Human Resources","HR Manager","Director Finance & Administration","Finance Manager","Programme/Technical Officer","Operations Manager"])||(exists(/databases/$(database)/documents/employees/$(uid))&&(get(/databases/$(database)/documents/employees/$(uid)).data.get("status","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("employmentStatus","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("registrationStatus","")=="Activated")&&get(/databases/$(database)/documents/employees/$(uid)).data.get("role","") in ["Director Internal Oversight","Internal Oversight Officer","Director Human Resources","HR Manager","Director Finance & Administration","Finance Manager","Programme/Technical Officer","Operations Manager"]);}
  function authorizationApproverRole(uid){return (exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.get("role","")=="Executive Director")||(exists(/databases/$(database)/documents/employees/$(uid))&&(get(/databases/$(database)/documents/employees/$(uid)).data.get("status","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("employmentStatus","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("registrationStatus","")=="Activated")&&get(/databases/$(database)/documents/employees/$(uid)).data.get("role","")=="Executive Director");}
  function authorizationImplementerRole(uid){return (exists(/databases/$(database)/documents/members/$(uid))&&get(/databases/$(database)/documents/members/$(uid)).data.status=="Active"&&get(/databases/$(database)/documents/members/$(uid)).data.get("role","") in ["Executive Director","Director Finance & Administration","Finance Manager","Operations Manager","Programme/Technical Officer","Director Human Resources","HR Manager"])||(exists(/databases/$(database)/documents/employees/$(uid))&&(get(/databases/$(database)/documents/employees/$(uid)).data.get("status","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("employmentStatus","")=="Active"||get(/databases/$(database)/documents/employees/$(uid)).data.get("registrationStatus","")=="Activated")&&get(/databases/$(database)/documents/employees/$(uid)).data.get("role","") in ["Executive Director","Director Finance & Administration","Finance Manager","Operations Manager","Programme/Technical Officer","Director Human Resources","HR Manager"]);}
  function validAuthorizationCreate(){return authorizationUser()&&request.resource.data.workflowType=="Authorization"&&request.resource.data.module=="Authorization & Approvals"&&request.resource.data.status=="Draft"&&request.resource.data.stageIndex==0&&request.resource.data.requestedByUid==request.auth.uid&&request.resource.data.requestedByUid!=request.resource.data.approverUid&&request.resource.data.reviewerUid is string&&request.resource.data.approverUid is string&&authorizationReviewerRole(request.resource.data.reviewerUid)&&authorizationApproverRole(request.resource.data.approverUid)&&request.resource.data.involvedUids is list&&request.resource.data.involvedUids.hasAll([request.auth.uid,request.resource.data.reviewerUid,request.resource.data.approverUid])&&(!request.resource.data.keys().hasAny(["implementerUid"])||request.resource.data.implementerUid==null||authorizationImplementerRole(request.resource.data.implementerUid));}
  function authorizationImmutable(){return request.resource.data.workflowType==resource.data.workflowType&&request.resource.data.module==resource.data.module&&request.resource.data.reference==resource.data.reference&&request.resource.data.title==resource.data.title&&request.resource.data.requestedByUid==resource.data.requestedByUid&&request.resource.data.requestedByEmail==resource.data.requestedByEmail&&request.resource.data.reviewerUid==resource.data.reviewerUid&&request.resource.data.approverUid==resource.data.approverUid&&request.resource.data.implementerUid==resource.data.implementerUid&&request.resource.data.involvedUids==resource.data.involvedUids;}
  function authorizationTransitionAllowed(){return authorizationImmutable()&&((resource.data.status=="Draft"&&request.resource.data.status=="Submitted"&&request.resource.data.stageIndex==1&&resource.data.requestedByUid==request.auth.uid)||(resource.data.status=="Submitted"&&request.resource.data.status=="Under Review"&&request.resource.data.stageIndex==2&&resource.data.reviewerUid==request.auth.uid&&authorizationReviewerRole(request.auth.uid))||(resource.data.status in ["Submitted","Under Review"]&&request.resource.data.status=="Returned"&&request.resource.data.stageIndex==5&&resource.data.reviewerUid==request.auth.uid&&authorizationReviewerRole(request.auth.uid)&&request.resource.data.decisionReason is string&&request.resource.data.decisionReason.size()>0)||(resource.data.status=="Under Review"&&request.resource.data.status=="Approved"&&request.resource.data.stageIndex==3&&resource.data.approverUid==request.auth.uid&&authorizationApproverRole(request.auth.uid)&&resource.data.requestedByUid!=request.auth.uid)||(resource.data.status=="Under Review"&&request.resource.data.status=="Rejected"&&request.resource.data.stageIndex==4&&resource.data.approverUid==request.auth.uid&&authorizationApproverRole(request.auth.uid)&&resource.data.requestedByUid!=request.auth.uid&&request.resource.data.decisionReason is string&&request.resource.data.decisionReason.size()>0)||(resource.data.status=="Returned"&&request.resource.data.status=="Submitted"&&request.resource.data.stageIndex==1&&resource.data.requestedByUid==request.auth.uid)||(resource.data.status=="Approved"&&request.resource.data.status=="Completed"&&request.resource.data.stageIndex==6&&resource.data.implementerUid==request.auth.uid&&authorizationImplementerRole(request.auth.uid)));}
  // Browser FCM tokens are private to the authenticated account. Cloud Functions
  // can still read these documents with Admin SDK for notification delivery.
  match /notificationTokens/{uid}/tokens/{tokenId} {
    allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
