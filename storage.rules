rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/adminProfiles/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/adminProfiles/$(request.auth.uid)).data.active == true;
    }
    match /signatureProfiles/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && (request.auth.uid == uid || admin())
        && request.resource.size < 1048576
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
