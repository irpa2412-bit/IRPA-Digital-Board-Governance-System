rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // IRPA-DGBS uses the controlled Google Drive gateway for document storage.
    // Firebase Storage is therefore deny-by-default until a specific Firebase
    // Storage path is intentionally introduced and covered by security tests.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
