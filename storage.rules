rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // BUILD PHASE ONLY: authenticated users can exercise all Storage-backed workflows.
    // Replace with path-, role-, file-type- and ownership-specific rules during hardening.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
