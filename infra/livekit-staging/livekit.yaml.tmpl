port: 7880
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true

turn:
  enabled: true
  domain: turn.irpa.or.tz
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/letsencrypt/live/irpa-livekit/fullchain.pem
  key_file: /etc/letsencrypt/live/irpa-livekit/privkey.pem

keys:
  "${LIVEKIT_API_KEY}": "${LIVEKIT_API_SECRET}"

# Single-node staging only. Do not point this configuration at production
# governance storage. LiveKit's room/media state is separate from Firestore.
