# Firebase Cloud Messaging Web Push
# Get this from Firebase Console -> Project settings -> Cloud Messaging -> Web configuration.
VITE_FIREBASE_VAPID_KEY=REPLACE_WITH_FIREBASE_WEB_PUSH_CERTIFICATE_KEY_PAIR_PUBLIC_KEY

# Google Weather API (enable Weather API and store the restricted key in GitHub Actions secrets)
VITE_GOOGLE_WEATHER_API_KEY=REPLACE_WITH_RESTRICTED_GOOGLE_WEATHER_API_KEY

# Optional isolated staging Firebase + Cloudflare LiveKit Worker.
# Use these settings only for a staging build. Obtain values from the Firebase
# Web app configuration for project irpa-dbg-staging-a73ec.
VITE_FIREBASE_API_KEY=REPLACE_WITH_STAGING_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=irpa-dbg-staging-a73ec.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=irpa-dbg-staging-a73ec
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_STAGING_WEB_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=
VITE_LIVEKIT_TOKEN_WORKER_URL=https://irpa-dgb-livekit-token-staging.irpa-governance.workers.dev
