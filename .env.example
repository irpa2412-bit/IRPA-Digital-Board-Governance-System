# Firebase Cloud Messaging Web Push
# Get this from Firebase Console -> Project settings -> Cloud Messaging -> Web configuration.
VITE_FIREBASE_VAPID_KEY=REPLACE_WITH_FIREBASE_WEB_PUSH_CERTIFICATE_KEY_PAIR_PUBLIC_KEY

# Google Weather API (enable Weather API and store the restricted key in GitHub Actions secrets)
VITE_GOOGLE_WEATHER_API_KEY=REPLACE_WITH_RESTRICTED_GOOGLE_WEATHER_API_KEY

# Firebase App Check (register the web app and reCAPTCHA v3 provider in Firebase Console first)
VITE_FIREBASE_APPCHECK_SITE_KEY=REPLACE_WITH_REGISTERED_RECAPTCHA_V3_SITE_KEY
