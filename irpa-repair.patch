+test("completion failure leaves no orphan files and can be retried", async () => {
+  const s = setup();
+  const id = await makeEnvelope(s, [{ name: "Amina", email: "a@example.org" }]);
+  const before = s.storage.objs.size;
+  s.storage.failPutWhen = (n, args) => args.metadata?.state === "Final Completed Document" && args.metadata.archive === "board-governance";
+  const r = await route(sign1(s.tokenFor("a@example.org")), s.ctx);
+  const out = await r.json();
+  assert.equal(out.completed, false);
+  assert.equal(out.status, "CompletionFailed");
+  assert.equal(s.storage.objs.size, before);
+
+  s.storage.failPutWhen = null;
+  const retry = await route(post(`/api/envelopes/${id}/retry-completion`, {}, "u1"), s.ctx);
+  assert.equal(retry.status, 200);
+  assert.equal((await retry.json()).completed, true);
+  assert.equal(s.storage.objs.size, before + 4); // 2 archives + owner + 1 signer
+  assert.equal((await route(post(`/api/envelopes/${id}/retry-completion`, {}, "u2"), s.ctx)).status, 403);
+  const st = await (await route(get(`/api/envelopes/${id}`, { user: "u1" }), s.ctx)).json();
+  assert.equal(st.auditChainValid, true);
+});
