rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    // Existing application collections remain available to authenticated users during build/testing.
    match /{document=**} {
      allow read, write: if signedIn();
    }

    // Notification tokens are restricted to the authenticated owner even during build.
    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow read, write: if self(uid);
    }
  }
}
