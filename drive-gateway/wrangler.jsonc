{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irpa-google-drive-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [],
  "kv_namespaces": [
    {
      "binding": "DRIVE_KV",
      "id": "ccdbffa662ac48bfbdf7f4b1f62ca941"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "irpa-digital-board-governance",
    "AUTHORIZED_DRIVE_EMAIL": "irpa2412@gmail.com",
