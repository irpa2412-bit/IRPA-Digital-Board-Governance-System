{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irpa-digital-board-governance-frontend",
  "main": "cloudflare-frontend-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/__irpa_health"],
    "not_found_handling": "single-page-application"
  }
}
